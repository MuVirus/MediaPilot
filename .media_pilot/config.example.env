# Copy this file to config.env in this directory and fill in real values.
# config.env is gitignored. Never commit real keys.
#
# Lookup order when the gateway starts:
#   1. MEDIAPILOT_CONFIG_DIR (explicit directory)
#   2. <working directory>/.media_pilot
#   3. <home directory>/.media_pilot
# The local file overrides the user-wide one for the same key; missing keys
# fall back to the user-wide file. Process environment wins over both.
# Run the gateway from the directory whose .media_pilot should be read.
DASHSCOPE_API_KEY=
MEDIAPILOT_REALTIME_MODEL=qwen-audio-3.1-realtime-plus
MEDIAPILOT_REALTIME_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
MEDIAPILOT_REALTIME_VOICE=longanqian_v3.1

# Gateway
MEDIAPILOT_BIND=127.0.0.1:8787
MEDIAPILOT_WEB_ROOT=web
# MEDIAPILOT_INSTRUCTIONS=You are a concise voice assistant.

# Concurrency. Each session owns one upstream connection; ACP sessions also
# own one agent process.
MEDIAPILOT_MAX_SESSIONS=16
# Queued delegate_task jobs per session.
MEDIAPILOT_MAX_TASKS=4

# Optional shared secret. Leave empty to disable auth. Clients pass it as
# `Authorization: Bearer <token>` or `?token=<token>` on the WebSocket.
# Never log it.
# MEDIAPILOT_AUTH_TOKEN=

# Agent backend: llm (default), acp, or none.
MEDIAPILOT_BACKEND=llm

# LLM backend (OpenAI-compatible chat completions)
MEDIAPILOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEDIAPILOT_LLM_MODEL=qwen-plus
# MEDIAPILOT_LLM_SYSTEM=You are a concise voice assistant.

# ACP backend, used when MEDIAPILOT_BACKEND=acp.
# MEDIAPILOT_ACP_COMMAND=opencode
# MEDIAPILOT_ACP_MODE=acp
# Allowed agent working directories, separated by ';'. The first entry is the
# default. When unset, only MEDIAPILOT_ACP_CWD is allowed. Clients choose one
# per session from GET /api/workspaces.
# MEDIAPILOT_ACP_ROOTS=D:\work\alpha;D:\work\beta
# MEDIAPILOT_ACP_CWD=
# MEDIAPILOT_ACP_MODEL=deepseek/deepseek-v4-pro

# Optional, only for `moon run cmd/dashscope-smoke`.
# Path to a raw PCM16 mono 16 kHz file used as the uplink turn.
# MEDIAPILOT_SMOKE_PCM=
# `manual` disables server turn detection so the probe sends
# input_audio_buffer.commit itself. Any other value is used as the
# turn_detection type.
# MEDIAPILOT_SMOKE_TURN_DETECTION=
