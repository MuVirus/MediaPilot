import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async/socket",
  "MuVirus/MediaPilot/backend",
  "MuVirus/MediaPilot/config",
  "MuVirus/MediaPilot/gateway",
  "MuVirus/MediaPilot/ports",
  "MuVirus/MediaPilot/protocol",
  "MuVirus/MediaPilot/realtime",
}

pkgtype(kind: "executable")

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/process",
    "moonbitlang/core/async/socket",
  ],
)
